{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.11.2/schemas/config.json",
  "release-type": "python",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": true,
  "packages": {
    "packages/docmost-client": {
      "component": "docmost-client",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='docmost-client')].version"
        }
      ]
    },
    "packages/yugen-docmost-mcp": {
      "component": "yugen-docmost-mcp",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='yugen-docmost-mcp')].version"
        }
      ]
    }
  }
}
